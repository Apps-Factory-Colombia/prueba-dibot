{
  "name": "prueba-dibot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun node_modules/vite/bin/vite.js",
    "dev:api": "bun --watch api/index.ts",
    "build": "bun scripts/build.ts",
    "build:wrapper": "bun scripts/build-wrapper.ts",
    "build:app": "bun node_modules/vite/bin/vite.js build",
    "build:server": "bun scripts/build-esbuild.ts",
    "validate:changed": "bun scripts/validate-changed.ts",
    "analyze": "bun scripts/analyze-bundles.ts",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "preview": "bun node_modules/vite/bin/vite.js preview",
    "opencode:serve": "opencode serve --hostname 127.0.0.1 --port 4096",
    "opencode:events": "bun scripts/opencode-events.ts",
    "db:check": "bun scripts/provision-turso.ts check",
    "db:create": "bun scripts/provision-turso.ts create",
    "db:verify": "bun scripts/verify-turso.ts",
    "db:seed": "bun api/db/seed.ts",
    "db:snapshot": "bun scripts/snapshot-database.ts before",
    "db:snapshot:verify": "bun scripts/snapshot-database.ts verify",
    "test:functional": "bun api/smoke.ts",
    "db:push": "bun node_modules/drizzle-kit/bin.cjs push",
    "db:generate": "bun node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun node_modules/drizzle-kit/bin.cjs migrate",
    "storage:provision": "bun scripts/provision-storage.ts",
    "verify:contracts": "bun scripts/verify-runtime-contracts.ts",
    "verify:generated": "bun scripts/verify-generated-app.ts",
    "verify:api": "bun scripts/verify-api.ts",
    "typecheck:app": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json",
    "typecheck:node": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json",
    "typecheck:server": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.server.json",
    "ensure:deps": "bun scripts/ensure-dependencies.ts",
    "dibot:verify:fast": "bun run verify:contracts && bun run verify:generated && bun run typecheck:app && bun run typecheck:node && bun run typecheck:server && bun run lint",
    "dibot:verify:release": "bun run verify:contracts && bun run verify:generated && bun run db:push && bun run db:seed && bun run db:verify && bun run build && bun run verify:api && bun run test:functional && bun run lint",
    "dibot:verify": "bun run ensure:deps && bun run dibot:verify:release",
    "dibot:workflow": "bun run ensure:deps && bun scripts/dibot-workflow.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "install": "^0.13.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
